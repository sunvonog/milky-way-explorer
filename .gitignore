# --- Python ---
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# --- Node / frontend ---
node_modules/
dist/
.vite/
coverage/

# --- Environment & secrets ---
.env
.env.*
!.env.example

# Small, immutable reference sources ARE vendored for reproducibility.
# This exception is ONLY for tiny text catalogues. Large or regenerable data
# (Gaia chunks, processed Parquet, tiles) stays ignored.
data/**
!data/**/
!data/**/.gitkeep
!data/raw/iau_csn/**
!data/raw/wgsn_faints/**
!data/raw/exoplanet_names/**
!data/raw/nasa_pscomppars/**
!data/raw/gaia_hosts/**
pipelines/_inputs/**

# small, intentional fixtures live with the tests instead
!pipelines/tests/fixtures/**
!backend/tests/fixtures/**

# --- OS / editor ---
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
